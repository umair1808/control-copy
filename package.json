{
  "name": "control-copy",
  "version": "0.4.0",
  "private": false,
  "description": "A Vue 3 component to easily add copy-to-clipboard functionality to any HTML input tag",
  "main": "dist/index.umd.js",
  "module": "dist/index.es.js",
  "types": "src/components/CtrlC.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist",
    "src/components/CtrlC.d.ts",
    "README.md"
  ],
  "keywords": [
    "ctrlc",
    "copy",
    "input",
    "html-input-tag",
    "click",
    "easy-copy"
  ],
  "author": "Umair Khan 📬 umair@siqasoft.com",
  "license": "ISC",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:demo": "vite build --config vite.demo.config.js"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "vite": "^6.0.0",
    "vitest": "^4.1.10",
    "vue": "^3.2.13"
  }
}
